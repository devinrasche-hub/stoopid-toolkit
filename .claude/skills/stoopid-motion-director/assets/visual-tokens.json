{
  "$comment": "STOOPID MOTION DIRECTOR — shared tokens. Templates stay self-contained (no fetch at runtime); copy the values you need into the piece. Palette and meanings are the documented SIGNAL system — do not add colors.",
  "palette": {
    "black":       { "hex": "#000000", "meaning": "base / void — the stage" },
    "white":       { "hex": "#FFFFFF", "meaning": "clarity / the subject the viewer identifies with" },
    "teal":        { "hex": "#00FFC6", "meaning": "digital / signal / the system doing the escalating" },
    "purple":      { "hex": "#8A2BE2", "meaning": "surreal / philosophical / the layer beneath" },
    "red":         { "hex": "#FF2D2D", "meaning": "absurd urgency / what it costs" },
    "burntOrange": { "hex": "#CC5500", "meaning": "earned sincerity — RESERVED for the flip landing, spent once" }
  },
  "paletteRules": {
    "gradients": false,
    "accentsPerPiece": 2,
    "orangeBeforeFlip": false,
    "background": "#000000"
  },
  "type": {
    "display": { "family": "Bebas Neue", "fallback": "Impact, 'Arial Narrow', sans-serif", "use": "stamps, verdicts, counters", "trackingPx@1080": [8, 14] },
    "mono":    { "family": "Share Tech Mono", "fallback": "'Courier New', monospace", "use": "labels, data, timecodes, credits", "trackingPx@1080": [1, 3] },
    "sizes@1080ShortEdge": { "stamp": [90, 130], "counter": [60, 110], "label": [22, 34] },
    "maxSimultaneousSizes": 2,
    "warmFontsBeforeFirstFrame": true
  },
  "aspects": {
    "16:9":  { "w": 1920, "h": 1080, "default": true,  "primaryAxis": "horizontal", "margin": 0.05 },
    "9:16":  { "w": 1080, "h": 1920, "default": false, "primaryAxis": "vertical",   "safeAreaPx": { "top": 180, "bottom": 420, "right": 160 } },
    "1:1":   { "w": 1080, "h": 1080, "default": false, "primaryAxis": "radial",     "margin": 0.06 }
  },
  "timingMs": {
    "snapIn": [80, 150],
    "followMove": [250, 400],
    "bigReposition": [500, 800],
    "revealHold": [400, 700],
    "flipHold": [600, 1000],
    "minShot": 500,
    "wordOnScreen": { "floor": 1000, "perWord": 300 }
  },
  "easing": {
    "snap": "cubic-bezier(.2,0,0,1)",
    "weightedArrival": "cubic-bezier(.16,1,.3,1)",
    "anticipate": "cubic-bezier(.68,-.55,.27,1.55)",
    "mechanical": "linear",
    "drift": "cubic-bezier(.4,0,.6,1)"
  },
  "physics@1080ShortEdge": {
    "gravityPxPerS2": [2000, 3000],
    "dragPerFrame60": 0.98,
    "restitution": { "deadWeight": 0.2, "fun": 0.5, "rubber": 0.85 },
    "travelSpeedPxPerS": [600, 1200],
    "impactSquashScaleY": [0.7, 0.85]
  },
  "texture": {
    "scanlines": { "onPx": 2, "offPx": 4, "opacity": 0.05 },
    "grain": { "maxOpacity": 0.05, "fps": 12 },
    "cornerBrackets": { "lengthOfShortEdge": 0.05, "opacity": 0.5 },
    "glitchBurstMs": [80, 200],
    "maxEffectHitsPer15s": 3,
    "noFullFrameStrobe": true
  },
  "chrome": {
    "watermark": { "text": "@stoopidshow", "font": "mono", "sizeOfShortEdge": 0.026, "opacity": 0.4, "position": "top-center" },
    "creditLine": { "font": "mono", "color": "#00FFC6", "opacity": 0.55, "position": "bottom-left" },
    "schematicLabel": "SCHEMATIC · NOT TO SCALE"
  },
  "controlDefaults": {
    "ABSURDITY": 3, "SINCERITY": 2, "CHAOS": 2, "EDUCATION": 1,
    "LOOPABLE": false, "DEV_ON_SCREEN": false, "LENGTH_S": 18, "ASPECT": "16:9"
  },
  "beatBudgets": {
    "18s": { "hook": [0, 3], "escalation": [3, 9], "flip": [9, 14], "release": [14, 18] },
    "8s":  { "hook": [0, 1], "escalation": [1, 4], "flip": [4, 6],  "release": [6, 8] },
    "30s": { "hook": [0, 3], "escalation": [3, 16], "flip": [16, 24], "release": [24, 30] }
  }
}
